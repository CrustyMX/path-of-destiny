; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Path of Destiny"
config/description="Open-world action RPG. Explore hostile worlds, chase legendary loot, master devastating abilities, and face colossal bosses."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
LootManager="*res://scripts/autoload/loot_manager.gd"
AbilityManager="*res://scripts/autoload/ability_manager.gd"
WeaponLibrary="*res://scripts/autoload/weapon_library.gd"
AffixLibrary="*res://scripts/systems/affix_library.gd"
StatManager="*res://scripts/autoload/stat_manager.gd"
CombatFeedback="*res://scripts/ui/combat_feedback.gd"
AimDebug="*res://scripts/ui/aim_debug.gd"
GrenadeDebug="*res://scripts/ui/grenade_debug.gd"
GameDiag="*res://scripts/ui/game_diag.gd"
ScreenshotCapture="*res://scripts/ui/screenshot_capture.gd"
GrenadeManager="*res://scripts/autoload/grenade_manager.gd"
HealthPotionManager="*res://scripts/autoload/health_potion_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

